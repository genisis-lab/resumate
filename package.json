{
  "name": "resumate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ResuMate - self-serve resume-building software with deterministic job matching and PDF/Word export.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prepare:assets": "node scripts/copy-pdf-worker.mjs",
    "typecheck:api": "tsc -p tsconfig.functions.json",
    "build": "npm run prepare:assets && tsc -b && npm run typecheck:api && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:offline": "npm run prepare:assets && node scripts/build-offline.mjs",
    "pages:deploy": "wrangler pages deploy dist --project-name resumate"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@whop/sdk": "1.0.14",
    "cmdk": "1.1.1",
    "lucide-react": "1.46.0",
    "pdfjs-dist": "^4.8.69",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@types/node": "26.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
