{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resumate",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resumate-accounts",
      "database_id": "816a3661-4b18-4421-9e1e-77e73ec467b7",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "https://resume.builtwai.com",
    "EMAIL_FROM": "ResuMate <verification@contact.builtwai.com>",
    "WHOP_CHECKOUT_ENABLED": "true",
    "WHOP_BUSINESS_ID": "biz_XNbFaV2vqlnbDu",
    "WHOP_RESUMATE_PRODUCT_ID": "prod_ohtoVdNv8Bcr0",
    "WHOP_RESUMATE_SPRINT_PLAN_ID": "plan_GxGtsMlfd53Xw",
    "WHOP_RESUMATE_PRO_PLAN_ID": "plan_MEz1b5mn84LpV"
  },
  "observability": {
    "enabled": true
  }
}
